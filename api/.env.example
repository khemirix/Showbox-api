# Port the API listens on (Render sets this automatically)
PORT=3000

# Logged-in Febbox `ui` cookie. Required for /api/febbox/links.
# Log in at https://www.febbox.com, copy the `ui` cookie value from your
# browser's developer tools (Application → Cookies), and paste it here.
# Never commit the real value.
FEBBOX_UI_COOKIE=
