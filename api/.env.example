# Port the API listens on (Render sets this automatically)
PORT=3000

# No Febbox cookie needed: the personal session is bundled in
# api/src/FebBoxApi.js, so the API works with zero configuration.

# Subtitle providers (server-side only; never expose these to the browser).
# MySubs and subtitles.website need no credentials.
SUBDL_API_KEY=
WYZIE_SUBS_API_KEY=
OPENSUBTITLES_API_KEY=

# Optional: raises the OpenSubtitles.com download allowance. Search and
# anonymous downloads work with OPENSUBTITLES_API_KEY alone.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Optional: override combined provider search timeout in milliseconds.
SUBTITLE_SEARCH_TIMEOUT_MS=12000
